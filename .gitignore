# Data — never commit the raw Kaggle CSV (146 MB) or any derivatives
data/*.csv
data/*.zip
data/raw/
data/processed/
!data/.gitkeep
!data/README.md

# Results — keep small markdown/png summaries but not pickled models
results/*.pkl
results/*.joblib
results/*.npy
!results/.gitkeep
!results/README.md

